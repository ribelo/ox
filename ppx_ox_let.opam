# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "let%bind with local and yielding continuations for OxCaml"
description:
  "Rewrites let%bind and let%map into Ox.Result applications with [@nontail], so local and yielding values survive a bind. Retire it when OxCaml binding operators take mode-annotated continuations (parser.mly 'CR zqian: support mode annotation on letop'; oxcaml PR #6276)."
maintainer: ["Rafal Krzywaznia <r.krzywaznia@gmail.com>"]
authors: ["Rafal Krzywaznia"]
license: "MIT"
homepage: "https://github.com/ribelo/ox"
depends: [
  "dune" {>= "3.21"}
  "ocaml" {>= "5.4.0"}
  "conf-ox-oxcaml" {= version}
  "ocaml-compiler-libs"
  "ox_caps" {= version}
  "ox" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
