(test
 (name portability)
 (libraries ox eio eio_main))

; Row 55: required jitter randomness is a compile-time contract.

(rule
 (alias runtest)
 (deps
  (package ox)
  (glob_files compile_fail/*.ml)
  compile_fail/check.sh)
 (action
  (chdir
   compile_fail
   (run bash check.sh %{ocamlc} %{workspace_root}/../install/default/lib/ox))))
