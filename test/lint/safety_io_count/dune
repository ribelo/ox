; Optional acceptance requires OX_IO_COUNT_INSTALLED_PREFIX installed externally.
; Neither @install nor _build/install satisfies this real-installation witness.

(rule
 (alias io-count-cli)
 (deps check-cli.sh)
 (action
  (run bash %{dep:check-cli.sh} %{env:OX_IO_COUNT_INSTALLED_PREFIX=})))

(rule
 (alias runtest)
 (deps
  fixtures/.io_count_fixtures.objs/byte/io_count_fixtures__Clean_case.cmt
  fixtures/.io_count_fixtures.objs/byte/io_count_fixtures__Violating_case.cmt
  fixtures/.io_count_fixtures.objs/byte/io_count_fixtures__Warning_case.cmt
  ../../../lib/test/.ox_test.objs/byte/ox_test.cmt
  .io_count_pure.objs/byte/io_count_pure__Pure_case.cmt)
 (action
  (run ./test_io_count.exe)))
