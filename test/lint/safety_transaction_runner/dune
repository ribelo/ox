; ^safe-ldtb ^safe-j6t8 ^safe-r1xw: compact exact fixture and physical defect corpus.

(executable
 (name corpus)
 (modules corpus)
 (libraries lint_engine ox_test eio_main ox_sql))

(rule
 (targets transaction_witness.exe)
 (deps
  ../fixtures/transaction_witness.ml
  ../fixtures/transaction_witness.mli)
 (action
  (run
   ocamlfind
   ocamlopt
   -package
   ox_sql,ox_test,eio_main
   -linkpkg
   -I
   ../fixtures
   -o
   transaction_witness.exe
   ../fixtures/transaction_witness.mli
   ../fixtures/transaction_witness.ml)))

(rule
 (alias runtest)
 (deps
  ../clean/transaction_runner.ml
  ../clean/transaction_runner.mli
  ../violating/transaction_runner.ml
  ../violating/transaction_runner.mli
  ../clean/.concurrency_clean.objs/byte/concurrency_clean__Transaction_runner.cmti
  ../violating/.concurrency_violating.objs/byte/concurrency_violating__Transaction_runner.cmti
  ../clean/.concurrency_clean.objs/byte/concurrency_clean__Transaction_runner.cmt
  ../violating/.concurrency_violating.objs/byte/concurrency_violating__Transaction_runner.cmt)
 (action
  (progn
   (run
    ./corpus.exe
    --fixtures
    ../clean/.concurrency_clean.objs/byte/concurrency_clean__Transaction_runner.cmti
    ../clean/transaction_runner.mli
    ../violating/.concurrency_violating.objs/byte/concurrency_violating__Transaction_runner.cmti
    ../violating/transaction_runner.mli
    ../clean/.concurrency_clean.objs/byte/concurrency_clean__Transaction_runner.cmt
    ../clean/transaction_runner.ml
    ../violating/.concurrency_violating.objs/byte/concurrency_violating__Transaction_runner.cmt
    ../violating/transaction_runner.ml)
   (run
    bash
    -c
    "timeout 2 ./transaction_witness.exe --wrong-runner; test $? -eq 124")
   (run ./transaction_witness.exe --witness))))
