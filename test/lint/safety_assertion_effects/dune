; ^safe-pcom ^safe-u7cx: exact native witnesses are compiled in a fresh project.

(data_only_dirs evidence)

(executable
 (name check_typed)
 (modules check_typed)
 (libraries lint_engine ox_caps.door))

(rule
 (alias runtest)
 (deps
  source-check.sh
  runtime-check.sh
  (source_tree evidence)
  ../clean/assertion_effects.ml
  ../clean/assertion_effects.mli
  ../violating/assertion_effects.ml
  ../violating/assertion_effects.mli)
 (action
  (progn
   (run
    bash
    %{dep:source-check.sh}
    %{exe:check_typed.exe}
    evidence
    %{dep:../clean/assertion_effects.ml}
    %{dep:../violating/assertion_effects.ml})
   (run bash %{dep:runtime-check.sh} evidence))))
