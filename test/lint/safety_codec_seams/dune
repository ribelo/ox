(executable
 (name test_codec_seams)
 (modules test_codec_seams)
 (libraries lint_engine ox_test))

(executable
 (name audit)
 (modules audit)
 (libraries lint_engine ox_test))

(executable
 (name fault)
 (modules fault)
 (libraries lint_engine ox_test))

(rule
 (alias runtest)
 (deps
  source-check.sh
  (source_tree evidence)
  (package ox_http)
  (package ox_observability)
  (package ox_otel)
  (package ox_ai_systemone)
  (package ox_ai_realtime)
  (package ox_ai_openrouter)
  (package ox_app))
 (action
  (run
   bash
   %{dep:source-check.sh}
   %{exe:test_codec_seams.exe}
   evidence
   %{workspace_root}/../install/default)))

