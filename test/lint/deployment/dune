; ^nlint-hxar ^nlint-2nwm: standalone consumers, with no nested Dune lock on ox.

; ^nlintcov-8g4p: coverage.py runs outside Dune, after the live workspace build.
; Its paired structural fixtures run in Dune without mutating a Git index.

(rule
 (alias runtest)
 (deps coverage.py test_coverage.py)
 (action
  (run python3 %{dep:test_coverage.py})))

; Its inventory subprocess must not contend for the enclosing builder's workspace.

; ^nlintcov-q6n2: source_tree expands to declared source dependencies, not build outputs.

(rule
 (target fixture-sources)
 (deps
  (source_tree project)
  (source_tree mint)
  (source_tree volatile))
 (action
  (with-stdout-to
   %{target}
   (run bash -c "printf '%s\n' \"$@\"" -- %{deps}))))

; An arbitrary generated .ml pins provenance-based materialization without a name policy.

(subdir
 project
 (rule
  (target materialization-generated.ml)
  (action
   (with-stdout-to
    %{target}
    (echo "let generated_by_dune = ()")))))

(rule
 (alias runtest)
 (deps
  check.sh
  project/materialization-generated.ml
  (source_tree project)
  (source_tree volatile)
  (source_tree mint)
  (source_tree ../../../docs/rules)
  ../../../docs/caps.md
  (source_tree ../clean)
  (source_tree ../violating)
  (source_tree ../../caps/rules)
  ../violating/concurrency_violating.cma
  ../../caps/rules/violating/caps_violating.cma)
 (action
  (run
   bash
   %{dep:check.sh}
   %{exe:../../../lib/ox_lint/main.exe}
   %{workspace_root}
   %{dep:fixture-sources})))
