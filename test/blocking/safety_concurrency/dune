 (action
  (run
   bash
   %{dep:check-compile.sh}
   %{ocamlopt}
   %{lib:ox_blocking:ox_blocking.cmi}
   %{lib:ox:ox.cmi}
   %{lib:eio:eio.cmi}
   %{lib:eio.core:eio__core.cmi}
   %{dep:compile/positive.mli.in}
   %{dep:compile/positive.ml.in}
   %{dep:compile/raw.mli.in}
   %{dep:compile/raw.ml.in})))
