; ^nstress-xn75: executables deliberately have no runtest rules.

; ^nstress-ttto: Actor/Channel cancellation and accounting.

(executable
 (name actor_storm)
 (modules actor_storm)
 (libraries stress_support ox eio eio_main))

(rule
 (alias stress)
 (deps
  (env_var OX_STRESS_SEED))
 (action
  (run timeout 60 ./%{exe:actor_storm.exe} --seed 6060)))

(library
 (name stress_support)
 (modules stress_support)
 (libraries ox_app ox_caps))

(executable
 (name core_properties)
 (modules core_properties)
 (libraries
  stress_support
  ox
  eio
  eio_main
  eio.mock
  qcheck-core
  qcheck-core.runner))

(rule
 (alias stress)
 (deps
  (env_var OX_STRESS_SEED))
 (action
  (run timeout 60 ./%{exe:core_properties.exe} --seed 6075)))

