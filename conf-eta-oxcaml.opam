# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Verify Eta's supported OxCaml compiler"
description:
  "Checks that the selected compiler is exactly OxCaml 5.4.0+ox before compiling Eta."
maintainer: ["Rafal Krzywaznia <r.krzywaznia@gmail.com>"]
authors: ["Rafal Krzywaznia"]
license: "MIT"
homepage: "https://github.com/ribelo/eta"
x-maintenance-intent: ["(latest)"]
# Dune cannot express alternatives between package names. Keep this real conf
# package in Eta's root so makeOpamRepo discovers it for downstream consumers.
flags: conf
depends: [
  "ocaml" {= "5.4.0"}
  ("ocaml-variants" {= "5.4.0+ox"} | "ocaml-system" {= "5.4.0"})
]
build: [
  ["sh" "-ec" """
ocamlc -version | grep -Fx '5.4.0+ox' || {
  echo 'Eta requires OxCaml 5.4.0+ox; selected compiler is unsupported' >&2
  exit 1
}
"""]
]
