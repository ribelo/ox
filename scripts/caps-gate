#!/usr/bin/env bash
# ox's repository gate (^nlint-r01u ^ncaps-w6n2): every rule; no shipped --allow entries.
#   nix develop -c scripts/caps-gate
set -euo pipefail
cd "$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"

# Fresh typed evidence is required in this checkout.
exec _build/default/lib/ox_lint/main.exe --caps-gate --require-typed "$@"
