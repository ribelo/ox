ive71:builder=/nix/store/v8llyqw71lygr2llhmcc8ya5bdlzq45v-bash-5.3p9/bin/bash46:DSH_PROFILE_DIR=/home/ribelo/.dsh/profiles/web29:GNUPGHOME=/home/ribelo/.gnupg1367:shellHook=export OPAMROOT="${OPAMROOT:-$HOME/.cache/opam}"
export PKG_CONFIG_PATH="/nix/store/gfkx12n2ph1j6wpq8dp8h6mdfgw0kxn2-sqlite-3.53.1-dev/lib/pkgconfig:/nix/store/jvnhc1z9c04n4a7b2z2hzbajsa5i6ygd-openssl-3.6.3-dev/lib/pkgconfig:/nix/store/fjas1zgi2xawi1aldkyn2d920jc1avcf-zlib-1.3.2-dev/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
export ETA_LADYBUG_LIBRARY="/nix/store/s6cfbqy44gss1x6vls7m9x499vlq1aj8-ladybugdb-0.17.1-lib/lib/liblbug.so"
if [ -d "$OPAMROOT/5.4.0+ox" ]; then
  export OPAMSWITCH="5.4.0+ox"
  eval "$(opam env --switch "5.4.0+ox" --set-switch)"
fi
# opam env puts the switch's installed stublibs first on
# CAML_LD_LIBRARY_PATH, and a bytecode executable resolves
# dll<lib>_stubs.so through it (Dune emits -dllib but never
# -dllpath). A repository bytecode test therefore has to prepend
# its build-tree stub directory or it silently loads the
# installed copy; see
# docs/issues/devshell-stub-shadowing/01-use-build-tree-stubs.md.
export PATH="/nix/store/w1yxcs1sjvxp99dbvrr5h32sn75fihpd-eta-oxcaml-editor-tools/bin:$PATH"
if [ -t 1 ]; then
  echo "Eta OxCaml shell (5.4.0+ox)"
  echo "Run 'shared-ocaml-switch-init' to create shared OPAM switches."
  echo "Run 'eta-opam-install-ox' to pin this checkout's packages into 5.4.0+ox (it removes v1 Eta packages)."
  echo "Run 'eta-oxcaml-test-shipped' after setup to run the build and test gates."
fi
