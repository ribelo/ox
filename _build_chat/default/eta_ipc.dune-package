(lang dune 3.22)
(name eta_ipc)
(sections (lib .) (libexec .) (doc ../../doc/eta_ipc))
(files
 (lib
  (META
   dune-package
   eta_ipc.a
   eta_ipc.cma
   eta_ipc.cmi
   eta_ipc.cms
   eta_ipc.cmt
   eta_ipc.cmx
   eta_ipc.cmxa
   eta_ipc.ml
   eta_ipc__Listener.cmi
   eta_ipc__Listener.cms
   eta_ipc__Listener.cmsi
   eta_ipc__Listener.cmt
   eta_ipc__Listener.cmti
   eta_ipc__Listener.cmx
   listener.ml
   listener.mli
   opam))
 (libexec (eta_ipc.cmxs))
 (doc (README.md)))
(library
 (name eta_ipc)
 (kind normal)
 (archives (byte eta_ipc.cma) (native eta_ipc.cmxa))
 (plugins (byte eta_ipc.cma) (native eta_ipc.cmxs))
 (native_archives eta_ipc.a)
 (requires eta eio eio.unix unix)
 (main_module_name Eta_ipc)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name eta_ipc)
     (visibility public)
     (kind alias)
     (source (path Eta_ipc) (impl (path eta_ipc.ml-gen))))
    (name Eta_ipc)
    (modules
     (module
      (obj_name eta_ipc__Listener)
      (visibility public)
      (source
       (path Listener)
       (intf (path listener.mli))
       (impl (path listener.ml))))))
   (wrapped true))))
