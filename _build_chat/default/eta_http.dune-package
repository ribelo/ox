 (libexec (eta_http.cmxs))
 (doc (README.md))
 (stublibs (dlleta_http_stubs.so)))
(library
 (name eta_http)
 (kind normal)
 (archives (byte eta_http.cma) (native eta_http.cmxa))
 (plugins (byte eta_http.cma) (native eta_http.cmxs))
 (foreign_objects tls_openssl_alloc.o tls_openssl_stubs.o)
 (foreign_archives (archives (for all) (files libeta_http_stubs.a)))
 (foreign_dll_files ../stublibs/dlleta_http_stubs.so)
 (native_archives eta_http.a)
 (requires eta eio eio.unix cstruct unix)
 (main_module_name Eta_http)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name eta_http)
     (visibility public)
     (kind alias)
     (source (path Eta_http) (impl (path eta_http.ml-gen))))
    (name Eta_http)
