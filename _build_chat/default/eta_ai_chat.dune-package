 (doc (README.md)))
(library
 (name eta_ai_chat)
 (kind normal)
 (synopsis "One OpenAI-compatible chat completion with a JSON-object reply")
 (archives (byte eta_ai_chat.cma) (native eta_ai_chat.cmxa))
 (plugins (byte eta_ai_chat.cma) (native eta_ai_chat.cmxs))
 (native_archives eta_ai_chat.a)
 (requires eta eta_ai eta_json eta_observability eta_http eio yojson)
 (main_module_name Eta_ai_chat)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name eta_ai_chat__)
     (visibility public)
     (kind alias)
     (source (path Eta_ai_chat__) (impl (path eta_ai_chat__.ml-gen))))
    (name Eta_ai_chat)
    (modules
     (module
      (obj_name eta_ai_chat__Chat)
      (visibility public)
      (source (path Chat) (intf (path chat.mli)) (impl (path chat.ml))))
     (module
      (obj_name eta_ai_chat__Codecs)
      (visibility public)
      (source (path Codecs) (intf (path codecs.mli)) (impl (path codecs.ml))))
     (module
      (obj_name eta_ai_chat)
      (visibility public)
      (source
       (path Eta_ai_chat)
       (intf (path eta_ai_chat.mli))
       (impl (path eta_ai_chat.ml))))
     (module
      (obj_name eta_ai_chat__Types)
      (visibility public)
      (source (path Types) (intf (path types.mli)) (impl (path types.ml))))))
   (wrapped true))))
