(lang dune 3.22)
(name eta_json)
(sections (lib .) (libexec .) (doc ../../doc/eta_json))
(files
 (lib
  (META
   dune-package
   eta_json.a
   eta_json.cma
   eta_json.cmi
   eta_json.cms
   eta_json.cmsi
   eta_json.cmt
   eta_json.cmti
   eta_json.cmx
   eta_json.cmxa
   eta_json.ml
   eta_json.mli
   opam))
 (libexec (eta_json.cmxs))
 (doc (README.md)))
(library
 (name eta_json)
 (kind normal)
 (synopsis
  "Untyped JSON accessors for Eta: bounded parse, builders, member reads")
 (archives (byte eta_json.cma) (native eta_json.cmxa))
 (plugins (byte eta_json.cma) (native eta_json.cmxs))
 (native_archives eta_json.a)
 (requires yojson)
 (main_module_name Eta_json)
 (modes byte native)
 (modules
  (singleton
   (obj_name eta_json)
   (visibility public)
   (source
    (path Eta_json)
    (intf (path eta_json.mli))
    (impl (path eta_json.ml))))))
