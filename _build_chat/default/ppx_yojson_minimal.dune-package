   __private__/ppx_yojson_minimal/ppx_yojson_minimal.ml
   __private__/ppx_yojson_minimal/ppx_yojson_minimal__Derive.cmx
   dune-package
   opam))
 (libexec (__private__/ppx_yojson_minimal/ppx_yojson_minimal.cmxs))
 (bin (ppx-yojson-minimal))
 (doc (README.md)))
(library
 (name ppx_yojson_minimal.__private__.ppx_yojson_minimal)
 (kind normal)
 (synopsis "Minimal [@@deriving yojson] preprocessor for OxCaml")
 (archives
  (byte __private__/ppx_yojson_minimal/ppx_yojson_minimal.cma)
  (native __private__/ppx_yojson_minimal/ppx_yojson_minimal.cmxa))
 (plugins
  (byte __private__/ppx_yojson_minimal/ppx_yojson_minimal.cma)
  (native __private__/ppx_yojson_minimal/ppx_yojson_minimal.cmxs))
 (native_archives __private__/ppx_yojson_minimal/ppx_yojson_minimal.a)
 (requires ocaml-compiler-libs.common)
 (main_module_name Ppx_yojson_minimal)
 (modes byte native)
 (obj_dir
  (public_cmi_ocaml_dir .public_cmi)
  (public_cmi_melange_dir melange/.public_cmi_melange))
 (modules
  (wrapped
   (group
    (alias
     (obj_name ppx_yojson_minimal)
     (visibility public)
     (kind alias)
     (source
      (path Ppx_yojson_minimal)
      (impl (path __private__/ppx_yojson_minimal/ppx_yojson_minimal.ml-gen))))
    (name Ppx_yojson_minimal)
    (modules
     (module
      (obj_name ppx_yojson_minimal__Derive)
      (visibility public)
      (source
       (path Derive)
       (intf (path __private__/ppx_yojson_minimal/derive.mli))
       (impl (path __private__/ppx_yojson_minimal/derive.ml))))))
   (wrapped true))))
