(lang dune 3.22)
(name ppx_yojson_minimal)
(sections
 (lib .)
 (libexec .)
 (bin ../../bin)
 (doc ../../doc/ppx_yojson_minimal))
(files
 (lib
  (META
   __private__/ppx_yojson_minimal/.public_cmi/ppx_yojson_minimal.cmi
   __private__/ppx_yojson_minimal/.public_cmi/ppx_yojson_minimal.cms
   __private__/ppx_yojson_minimal/.public_cmi/ppx_yojson_minimal.cmt
