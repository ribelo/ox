(lang dune 3.22)
(name eta_app)
(sections (lib .) (libexec .) (doc ../../doc/eta_app))
(files
 (lib
  (META
   config.ml
   config.mli
   dune-package
   env.ml
   env.mli
   eta_app.a
   eta_app.cma
   eta_app.cmi
   eta_app.cms
   eta_app.cmsi
   eta_app.cmt
   eta_app.cmti
   eta_app.cmx
   eta_app.cmxa
   eta_app.ml
   eta_app.mli
   eta_app__.cmi
   eta_app__.cms
   eta_app__.cmt
   eta_app__.cmx
   eta_app__.ml
   eta_app__Config.cmi
   eta_app__Config.cms
   eta_app__Config.cmsi
   eta_app__Config.cmt
   eta_app__Config.cmti
   eta_app__Config.cmx
   eta_app__Env.cmi
   eta_app__Env.cms
   eta_app__Env.cmsi
   eta_app__Env.cmt
   eta_app__Env.cmti
   eta_app__Env.cmx
   eta_app__Status.cmi
   eta_app__Status.cms
   eta_app__Status.cmsi
   eta_app__Status.cmt
   eta_app__Status.cmti
   eta_app__Status.cmx
   opam
   status.ml
   status.mli))
 (libexec (eta_app.cmxs))
 (doc (README.md)))
(library
 (name eta_app)
 (kind normal)
 (archives (byte eta_app.cma) (native eta_app.cmxa))
 (plugins (byte eta_app.cma) (native eta_app.cmxs))
 (native_archives eta_app.a)
 (requires eta eta_observability eio eio_main cmdliner toml yojson)
 (main_module_name Eta_app)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name eta_app__)
     (visibility public)
     (kind alias)
     (source (path Eta_app__) (impl (path eta_app__.ml-gen))))
    (name Eta_app)
    (modules
     (module
      (obj_name eta_app__Config)
      (visibility public)
      (source (path Config) (intf (path config.mli)) (impl (path config.ml))))
     (module
      (obj_name eta_app__Env)
      (visibility public)
      (source (path Env) (intf (path env.mli)) (impl (path env.ml))))
     (module
      (obj_name eta_app)
      (visibility public)
      (source
       (path Eta_app)
       (intf (path eta_app.mli))
       (impl (path eta_app.ml))))
     (module
      (obj_name eta_app__Status)
      (visibility public)
      (source (path Status) (intf (path status.mli)) (impl (path status.ml))))))
   (wrapped true))))
