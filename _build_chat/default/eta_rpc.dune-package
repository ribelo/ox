(lang dune 3.22)
(name eta_rpc)
(sections (lib .) (libexec .) (doc ../../doc/eta_rpc))
(files
 (lib
  (META
   correlator.ml
   correlator.mli
   dune-package
   eta_rpc.a
   eta_rpc.cma
   eta_rpc.cmi
   eta_rpc.cms
   eta_rpc.cmt
   eta_rpc.cmx
   eta_rpc.cmxa
   eta_rpc.ml
   eta_rpc__Correlator.cmi
   eta_rpc__Correlator.cms
   eta_rpc__Correlator.cmsi
   eta_rpc__Correlator.cmt
   eta_rpc__Correlator.cmti
   eta_rpc__Correlator.cmx
   opam))
 (libexec (eta_rpc.cmxs))
 (doc (README.md)))
(library
 (name eta_rpc)
 (kind normal)
 (archives (byte eta_rpc.cma) (native eta_rpc.cmxa))
 (plugins (byte eta_rpc.cma) (native eta_rpc.cmxs))
 (native_archives eta_rpc.a)
 (requires eta eio)
 (main_module_name Eta_rpc)
 (modes byte native)
 (modules
  (wrapped
   (group
    (alias
     (obj_name eta_rpc)
     (visibility public)
     (kind alias)
     (source (path Eta_rpc) (impl (path eta_rpc.ml-gen))))
    (name Eta_rpc)
    (modules
     (module
      (obj_name eta_rpc__Correlator)
      (visibility public)
      (source
       (path Correlator)
       (intf (path correlator.mli))
       (impl (path correlator.ml))))))
   (wrapped true))))
