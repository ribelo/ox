(library
 (name ox_sql)
 (public_name ox_sql)
 (synopsis "Direct-style SQLite client with typed SQL DSL")
 (foreign_stubs
  (language c)
  (names sqlite_stubs)
  (flags
   :standard
   (:include sqlite_c_flags.sexp)))
 (c_library_flags
  :standard
  (:include sqlite_c_library_flags.sexp))
 (libraries ox ox_caps ox_sql_dsl eio unix))

(rule
 (targets sqlite_c_flags.sexp sqlite_c_library_flags.sexp)
 (action
  (progn
   (with-stdout-to
    sqlite_c_flags.sexp
    (bash "echo '('; pkg-config sqlite3 --cflags | tr ' ' '\n'; echo ')'"))
   (with-stdout-to
    sqlite_c_library_flags.sexp
    (bash "echo '('; pkg-config sqlite3 --libs | tr ' ' '\n'; echo ')'")))))
