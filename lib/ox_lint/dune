; ^nlint-r01u: build-time only; compiler-matched tool installed under share/ox_lint.

(library
 (name lint_engine)
 (wrapped false)
 ; ^safe-fr73 ^safe-tlyw: rule modules stay independent; only the CLI is excluded.
 (modules
  (:standard \ main))
 (libraries ocaml-compiler-libs.common unix ox_caps))

(executable
 (name main)
 (modules main)
 (modes byte exe)
 (libraries lint_engine ox_caps.door))

; ^nlint-2nwm: private native-only targets otherwise have no retained CMT.

(alias
 (name install)
 (package ox_lint)
 (deps main.bc))

; ^ncapslint-x3gi: the executable goes in bin, where opam keeps the executable bit;
; share holds only the rule pages and fixtures --self-check reads (share is 0644).

(install
 (package ox_lint)
 (section bin)
 (files
  (main.exe as ox-lint)
  (../caps/caps-gate as caps-gate)))

; ^safe-fr73 ^safe-t37w: installed policies carry both interface and implementation evidence.

