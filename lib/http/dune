(library
 (name ox_http)
 (public_name ox_http)
 (libraries ox ox_json eio eio.unix cstruct unix)
 (foreign_stubs
  (language c)
  (names tls_openssl_stubs tls_openssl_alloc)
  (flags
   :standard
   (:include c_flags.sexp)))
 (c_library_flags
  :standard
  (:include c_library_flags.sexp)))

(rule
 (targets c_flags.sexp c_library_flags.sexp)
 (action
  (progn
   (with-stdout-to
    c_flags.sexp
    (bash "echo '('; pkg-config openssl --cflags | tr ' ' '\n'; echo ')'"))
   (with-stdout-to
    c_library_flags.sexp
    (bash "echo '('; pkg-config openssl --libs | tr ' ' '\n'; echo ')'")))))
