(library
 (name ppx_yojson_minimal)
 (modules derive)
 (package ppx_yojson_minimal)
 (synopsis "Minimal [@@deriving yojson] preprocessor for OxCaml")
 (libraries ocaml-compiler-libs.common))

(executable
 (name main)
 (modules main)
 (package ppx_yojson_minimal)
 (public_name ppx-yojson-minimal)
 ; ^nlint-2nwm: retain byte CMT evidence even for the installed native tool.
 (modes byte exe)
 ; Capabilities belong to the driver only, never the deriver library or its output.
 (libraries ppx_yojson_minimal ox_caps ox_caps.door))

(alias
 (name install)
 (package ppx_yojson_minimal)
 (deps main.bc))
