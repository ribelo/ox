#!/usr/bin/env bash
# ^ncapslint-x3gi ^ncapslint-87ld: shell-readable installed compiler gate.
# All inputs go through the compiler parser; no lexical fallback.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
engine="${OX_LINT:-$here/../ox_lint/ox-lint}"
if [[ ! -x "$engine" ]]; then
  echo "caps-gate: ox-lint missing; install ox_lint or set OX_LINT to its executable" >&2
  exit 2
fi
exec "$engine" --caps-gate "$@"
